<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delivery Term Tree View -->
    <record id="view_delivery_term_tree" model="ir.ui.view">
        <field name="name">delivery.term.list</field>
        <field name="model">delivery.term</field>
        <field name="arch" type="xml">
            <list string="Delivery Terms" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="picking_policy"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Delivery Term Form View -->
    <record id="view_delivery_term_form" model="ir.ui.view">
        <field name="name">delivery.term.form</field>
        <field name="model">delivery.term</field>
        <field name="arch" type="xml">
            <form string="Delivery Term">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Delivery Term"/>
                        <h1>
                            <field name="name" placeholder="e.g. Ex-Works, Door Delivery..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="picking_policy"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description / Notes">
                        <field name="note" nolabel="1" placeholder="Add terms details or client delivery notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Delivery Term Action -->
    <record id="action_delivery_term" model="ir.actions.act_window">
        <field name="name">Delivery Terms</field>
        <field name="res_model">delivery.term</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Delivery Term!
            </p>
            <p>
                Define delivery terms like As soon as possible, Ex-Works, Door Delivery, etc.
            </p>
        </field>
    </record>

    <!-- Menu Item under Sales -> Configuration -->
    <menuitem id="menu_delivery_term"
              name="Delivery Terms"
              parent="sale.menu_sale_config"
              action="action_delivery_term"
              sequence="20"/>
</odoo>

