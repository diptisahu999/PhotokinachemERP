<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_currency_sync" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.currency.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='update_exchange_rates']" position="replace">
                <setting id="update_exchange_rates" 
                         help="Automatically sync and update exchange rates (USD, EUR, etc.) daily"
                         documentation="/applications/finance/accounting/others/multi_currency.html">
                    <field name="auto_currency_rate_sync"/>
                    <div class="content-group" invisible="not auto_currency_rate_sync">
                        <div class="mt8">
                            <label for="currency_rate_provider" string="Provider: " class="fw-bold me-2"/>
                            <field name="currency_rate_provider" class="w-auto"/>
                        </div>
                        <div class="mt8 text-muted" invisible="not last_currency_rate_sync">
                            <span class="fa fa-clock-o me-1"/> Last Updated: <field name="last_currency_rate_sync" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <button name="action_sync_currency_rates_now"
                                    type="object"
                                    string="Update Rates Now"
                                    class="btn btn-secondary btn-sm"
                                    icon="fa-refresh"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

