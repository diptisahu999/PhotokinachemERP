<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add 'Update Live Rates Now' button to Currencies List view header -->
    <record id="view_currency_tree_inherit_sync" model="ir.ui.view">
        <field name="name">res.currency.tree.inherit.sync</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_sync_live_rates_button"
                            type="object"
                            string="Sync Live Rates Now"
                            class="btn btn-primary"
                            icon="fa-refresh"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Add 'Update Live Rates Now' button to Currency Form view header -->
    <record id="view_currency_form_inherit_sync" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.sync</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_sync_live_rates_button"
                            type="object"
                            string="Sync Live Rates Now"
                            class="btn btn-primary"
                            icon="fa-refresh"
                            invisible="is_current_company_currency"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>

