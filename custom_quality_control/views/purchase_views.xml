<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Form Inherit: Only smart button when inspections exist, no Quality Status badge on PO -->
    <record id="purchase_order_form_inherit_quality" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.quality</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button for QC Inspections: Only visible if inspections exist -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_qc_checks" type="object" class="oe_stat_button"
                        icon="fa-flask" invisible="qc_check_count == 0">
                    <div class="o_stat_info">
                        <field name="qc_check_count" class="o_stat_value"/>
                        <span class="o_stat_text">QA / QC Checks</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
