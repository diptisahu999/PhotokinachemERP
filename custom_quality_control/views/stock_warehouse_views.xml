<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_inherit_quality" model="ir.ui.view">
        <field name="name">stock.warehouse.inherit.quality</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_stock_id']" position="after">
                <field name="qc_location_id" options="{'no_create': True}"/>
                <field name="quarantine_location_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>

