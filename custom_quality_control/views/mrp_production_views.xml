<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MRP Production Form Inherit -->
    <record id="mrp_production_form_view_inherit_quality" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.quality</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Smart Button for QC Checks -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_qc_checks" type="object" class="oe_stat_button"
                        icon="fa-flask" invisible="qc_check_count == 0">
                    <div class="o_stat_info">
                        <field name="qc_check_count" class="o_stat_value"/>
                        <span class="o_stat_text">QA / QC Checks</span>
                    </div>
                </button>
            </xpath>

            <!-- QC Status Badge: Hidden when 'none' -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="qc_status" widget="badge"
                       decoration-info="qc_status == 'to_check'"
                       decoration-success="qc_status == 'passed'"
                       decoration-danger="qc_status == 'failed'"
                       decoration-warning="qc_status == 'pending'"
                       invisible="qc_status in ('none', False)"/>
            </xpath>
        </field>
    </record>

    <!-- MRP Production List / Tree Inherit -->
    <record id="mrp_production_tree_view_inherit_quality" model="ir.ui.view">
        <field name="name">mrp.production.list.inherit.quality</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="qc_status" widget="badge" optional="show"
                       decoration-info="qc_status == 'to_check'"
                       decoration-success="qc_status == 'passed'"
                       decoration-danger="qc_status == 'failed'"
                       decoration-warning="qc_status == 'pending'"
                       invisible="qc_status in ('none', False)"/>
            </xpath>
        </field>
    </record>
</odoo>
