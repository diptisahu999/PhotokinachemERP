<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom List View for Pending Sales Dispatches -->
    <record id="view_picking_tree_pending_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.pending.dispatch.list</field>
        <field name="model">stock.picking</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Pending Sales Dispatches" sample="1" multi_edit="1">
                <field name="priority" optional="show" widget="priority" nolabel="1"/>
                <field name="name" decoration-bf="1" string="Delivery Order"/>
                <field name="partner_id" string="Customer"/>
                <field name="sale_id" string="Sale Order"/>
                <field name="origin" string="Source Document" optional="show"/>
                <field name="sale_order_currency_id" column_invisible="True"/>
                <field name="order_value" string="Order Value" widget="monetary" options="{'currency_field': 'sale_order_currency_id'}" optional="show"/>
                <field name="scheduled_date" optional="show" widget="remaining_days"/>
                <field name="location_id" string="From" groups="stock.group_stock_multi_locations" optional="show"/>
                <field name="location_dest_id" string="To" groups="stock.group_stock_multi_locations" optional="show"/>
                <field name="products_availability" optional="show" widget="badge"
                       decoration-danger="products_availability_state == 'late' or products_availability == 'Not Available'"
                       decoration-warning="products_availability_state == 'expected'"
                       decoration-success="products_availability_state == 'available' and products_availability != 'Not Available'"/>
                <field name="products_availability_state" column_invisible="True"/>
                <field name="state" optional="show" widget="badge"
                       decoration-success="state == 'assigned' and products_availability_state != 'late' and products_availability != 'Not Available'"
                       decoration-warning="state in ('confirmed', 'waiting') or (state == 'assigned' and (products_availability_state == 'late' or products_availability == 'Not Available'))"/>
            </list>
        </field>
    </record>

    <!-- Custom Search View with Filters for Waiting and Ready -->
    <record id="view_picking_pending_dispatch_search" model="ir.ui.view">
        <field name="name">stock.picking.pending.dispatch.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_do_transfers']" position="before">
                <filter name="filter_ready" string="Ready to Dispatch" domain="[('state', '=', 'assigned')]"/>
                <filter name="filter_waiting" string="Waiting (Pending)" domain="[('state', 'in', ['confirmed', 'waiting'])]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Sale Order" name="group_by_sale_id" context="{'group_by': 'sale_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Picking Form View for Order Value & Remarks -->
    <record id="view_picking_form_inherit_sales_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.sales.dispatch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <!-- 1. Order Value under Source Document -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="sale_order_currency_id" invisible="1"/>
                <field name="order_value" string="Order Value" widget="monetary" options="{'currency_field': 'sale_order_currency_id'}" invisible="not sale_id"/>
            </xpath>

            <!-- 2. Fix Product Availability Color on Form View (Red when Not Available) -->
            <xpath expr="//field[@name='products_availability']" position="attributes">
                <attribute name="decoration-danger">products_availability_state == 'late' or products_availability == 'Not Available'</attribute>
                <attribute name="decoration-warning">products_availability_state == 'expected'</attribute>
                <attribute name="decoration-success">products_availability_state == 'available' and products_availability != 'Not Available'</attribute>
            </xpath>

            <!-- 3. Move Line Remarks in Operations Tab for Unavailable Product -->
            <xpath expr="//page[@name='operations']//field[@name='move_ids']/list/field[@name='forecast_availability']" position="after">
                <field name="is_not_available" column_invisible="True"/>
                <field name="remarks" string="Remarks" placeholder="Remarks for unavailable product..." optional="show" invisible="not is_not_available and not remarks"/>
            </xpath>
        </field>
    </record>

    <!-- Window Action: Pending Sales Dispatches -->
    <record id="action_pending_sales_dispatches" model="ir.actions.act_window">
        <field name="name">Pending Sales Dispatches</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="domain">[
            ('picking_type_code', '=', 'outgoing'),
            ('state', 'in', ['confirmed', 'waiting', 'assigned']),
            ('sale_id', '!=', False)
        ]</field>
        <field name="context">{
            'default_picking_type_code': 'outgoing',
            'contact_display': 'partner_address',
        }</field>
        <field name="search_view_id" ref="view_picking_pending_dispatch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Pending Sales Dispatches!
            </p>
            <p>
                All confirmed sales orders have been fully delivered, or no delivery orders are currently waiting or ready to dispatch.
            </p>
        </field>
    </record>

    <!-- Bind Views to Action in explicit order -->
    <record id="action_pending_sales_dispatches_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_picking_tree_pending_dispatch"/>
        <field name="act_window_id" ref="action_pending_sales_dispatches"/>
    </record>

    <record id="action_pending_sales_dispatches_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="stock.stock_picking_kanban"/>
        <field name="act_window_id" ref="action_pending_sales_dispatches"/>
    </record>

    <record id="action_pending_sales_dispatches_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock.view_picking_form"/>
        <field name="act_window_id" ref="action_pending_sales_dispatches"/>
    </record>

    <!-- Menuitem under Sales -> Orders -->
    <menuitem id="menu_pending_sales_dispatches_sale"
              name="Pending Dispatches"
              parent="sale.sale_order_menu"
              action="action_pending_sales_dispatches"
              sequence="25"/>

    <!-- Menuitem under Inventory -> Operations -> Transfers -->
    <menuitem id="menu_pending_sales_dispatches_stock"
              name="Pending Sales Dispatches"
              parent="stock.menu_stock_transfers"
              action="action_pending_sales_dispatches"
              sequence="22"/>
</odoo>

