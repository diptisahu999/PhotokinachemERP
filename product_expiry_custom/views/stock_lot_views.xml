<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lot Tree / List View Inherit -->
    <record id="view_production_lot_tree_inherit_expiry_price" model="ir.ui.view">
        <field name="name">stock.lot.list.inherit.expiry.price</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">expiration_date asc, name asc</attribute>
            </xpath>
            <xpath expr="//field[@name='create_date']" position="before">
                <field name="currency_id" column_invisible="True"/>
                <field name="is_expired" column_invisible="True"/>
                <field name="is_expiring_soon" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="decoration-danger">is_expired</attribute>
                <attribute name="decoration-warning">is_expiring_soon</attribute>
                <attribute name="decoration-bf">is_expired or is_expiring_soon</attribute>
            </xpath>
            <xpath expr="//field[@name='expiration_date']" position="after">
                <field name="purchase_price" optional="show" string="Purchase Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="purchase_order_id" optional="show" string="Purchase Order"/>
            </xpath>
        </field>
    </record>

    <!-- Lot Form View Inherit -->
    <record id="view_production_lot_form_inherit_purchase_price" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.purchase.price</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="currency_id" invisible="1"/>
                <field name="purchase_price" string="Purchase Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="purchase_order_id" readonly="1" invisible="not purchase_order_id"/>
            </xpath>
        </field>
    </record>

    <!-- Lot Search View Inherit -->
    <record id="search_product_lot_filter_inherit_expiry_price" model="ir.ui.view">
        <field name="name">stock.lot.search.inherit.expiry.price</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_by_product']" position="before">
                <filter string="Has Expiration Date" name="has_expiration_date" domain="[('expiration_date', '!=', False)]"/>
                <filter string="Expiring Soon (30 Days)" name="expiring_soon_30" domain="[('is_expiring_soon', '=', True)]"/>
                <filter string="Expired" name="expired" domain="[('is_expired', '=', True)]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Expiration Date" name="group_by_expiration_date" context="{'group_by': 'expiration_date'}"/>
                <filter string="Purchase Price" name="group_by_purchase_price" context="{'group_by': 'purchase_price'}"/>
                <filter string="Purchase Order" name="group_by_purchase_order" context="{'group_by': 'purchase_order_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
