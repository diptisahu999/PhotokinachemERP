<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View Inherit -->
    <record id="product_template_only_form_view_inherit_expiry" model="ir.ui.view">
        <field name="name">product.template.form.inherit.expiry</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="expiry_date"/>
            </xpath>
        </field>
    </record>

    <!-- Product Product (Variant) Form View Inherit -->
    <record id="product_normal_form_view_inherit_expiry" model="ir.ui.view">
        <field name="name">product.product.form.inherit.expiry</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="expiry_date"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Tree / List View Inherit -->
    <record id="product_template_tree_view_inherit_expiry" model="ir.ui.view">
        <field name="name">product.template.list.inherit.expiry</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="expiry_date" optional="show"/>
                <field name="standard_price" optional="show" string="Cost Price"/>
            </xpath>
        </field>
    </record>

    <!-- Product Product Tree / List View Inherit -->
    <record id="product_product_tree_view_inherit_expiry" model="ir.ui.view">
        <field name="name">product.product.list.inherit.expiry</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="expiry_date" optional="show"/>
                <field name="standard_price" optional="show" string="Cost Price"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Search View Inherit -->
    <record id="product_template_search_view_inherit_expiry" model="ir.ui.view">
        <field name="name">product.template.search.inherit.expiry</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="expiry_date"/>
            </xpath>
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <separator/>
                <filter string="Has Expiry Date" name="has_expiry_date" domain="[('expiry_date', '!=', False)]"/>
                <filter string="Expiring Soon (30 Days)" name="expiring_soon_30" domain="[('expiry_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('expiry_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Expired Products" name="expired_products" domain="[('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Expiry Date" name="group_by_expiry_date" context="{'group_by': 'expiry_date'}"/>
                <filter string="Sales Price" name="group_by_list_price" context="{'group_by': 'list_price'}"/>
                <filter string="Cost Price" name="group_by_standard_price" context="{'group_by': 'standard_price'}"/>
            </xpath>
        </field>
    </record>
</odoo>
