<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Quant Tree / List View Inherit -->
    <record id="view_stock_quant_tree_editable_inherit_expiry_price" model="ir.ui.view">
        <field name="name">stock.quant.list.inherit.expiry.price</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='expiration_date']" position="after">
                <field name="lot_currency_id" column_invisible="True"/>
                <field name="lot_cost" optional="show" string="Purchase Price" widget="monetary" options="{'currency_field': 'lot_currency_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Quant Search View Inherit -->
    <record id="quant_search_view_inherit_expiry_price" model="ir.ui.view">
        <field name="name">stock.quant.search.inherit.expiry.price</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='internal_loc']" position="after">
                <separator/>
                <filter string="Has Expiration Date" name="has_expiration_date" domain="[('expiration_date', '!=', False)]"/>
                <filter string="Expiring Soon (30 Days)" name="expiring_soon_30" domain="[('expiration_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('expiration_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Expiration Date" name="group_by_expiration_date" context="{'group_by': 'expiration_date'}"/>
            </xpath>
        </field>
    </record>
</odoo>
