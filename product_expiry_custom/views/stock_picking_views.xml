<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Detailed Operations page in Stock Picking Form -->
    <record id="view_picking_form_inherit_expiry" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.expiry</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_create_lots']" position="after">
                <field name="use_existing_lots" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='operations']" position="after">
                <page string="Detailed Operations" name="detailed_operations" invisible="state == 'draft'">
                    <field name="move_line_ids" context="{'default_picking_id': id, 'default_company_id': company_id}">
                        <list editable="bottom" decoration-muted="state == 'done'">
                            <field name="product_id" readonly="state == 'done'"/>
                            <field name="lot_name" string="Lot/Serial Number" column_invisible="not parent.use_create_lots" readonly="state == 'done'"/>
                            <field name="lot_id" string="Lot/Serial Number" column_invisible="parent.use_create_lots" readonly="state == 'done'"/>
                            <field name="expiration_date" readonly="not parent.use_create_lots or state == 'done'"/>
                            <field name="quantity" string="Done Qty" readonly="state == 'done'"/>
                            <field name="product_uom_id" string="Unit" readonly="state == 'done'"/>
                            <field name="state" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
