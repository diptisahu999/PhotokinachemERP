<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Purchase Approval toggle to User Form View (Settings -> Users & Companies -> Users) -->
    <record id="view_users_form_inherit_purchase_approval" model="ir.ui.view">
        <field name="name">res.users.form.inherit.purchase.approval</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Purchase Approval Authority" name="purchase_approval_group">
                    <field name="purchase_approval" widget="boolean_toggle"
                           help="If enabled, this user is authorized to approve or reject purchase requests and confirm them into Purchase Orders."/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add Purchase Approval column to User List View -->
    <record id="view_users_tree_inherit_purchase_approval" model="ir.ui.view">
        <field name="name">res.users.tree.inherit.purchase.approval</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='role']" position="after">
                <field name="purchase_approval" widget="boolean" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
