<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form View Inherit -->
    <record id="view_order_form_inherit_lost_customer" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.lost.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <!-- Alert Banner at top of Quotation -->
            <xpath expr="//sheet/div[contains(@class, 'oe_title')]" position="before">
                <div class="alert alert-danger d-flex align-items-center mb-3" role="alert" invisible="not is_lost_customer">
                    <i class="fa fa-exclamation-triangle fa-2x me-3 text-danger"/>
                    <div class="flex-grow-1">
                        <h5 class="alert-heading mb-1 fw-bold text-danger">⚠️ Lost Customer Notice</h5>
                        <div>This customer has had no deals or confirmed orders in the last 6 months (Inactive for <field name="partner_days_inactive" class="fw-bold"/> days). Special re-engagement terms or pricing may apply!</div>
                    </div>
                </div>
            </xpath>

            <!-- Badge beside Customer Field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_lost_customer" invisible="1"/>
                <span class="badge rounded-pill text-bg-danger ms-2 px-2 py-1 align-middle" invisible="not is_lost_customer">
                    <i class="fa fa-clock-o me-1"/>Lost Customer (6+ Months Inactive)
                </span>
            </xpath>
        </field>
    </record>

    <!-- Quotation List View Inherit -->
    <record id="view_quotation_tree_inherit_lost_customer" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.lost.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_lost_customer" column_invisible="True"/>
                <field name="lost_status_display" widget="badge" decoration-danger="lost_status_display" string="Customer Status" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Quotation Search View Inherit -->
    <record id="sale_order_view_search_inherit_quotation_lost_customer" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.lost.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_quotation']" position="after">
                <separator/>
                <filter string="Lost Customers" name="filter_lost_customers" domain="[('is_lost_customer', '=', True)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Lost Customer Status" name="group_by_lost_customer" context="{'group_by': 'is_lost_customer'}"/>
            </xpath>
        </field>
    </record>
</odoo>

