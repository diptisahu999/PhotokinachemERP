<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Lost Customer Tag Record -->
        <record id="partner_category_lost_customer" model="res.partner.category">
            <field name="name">Lost Customer</field>
            <field name="color">1</field>
        </record>

        <!-- Default inactivity threshold parameter (180 days = 6 months) -->
        <record id="param_lost_customer_days" model="ir.config_parameter">
            <field name="key">lost_customer.inactivity_days</field>
            <field name="value">180</field>
        </record>

        <!-- Daily Cron Job to scan and tag lost customers -->
        <record id="ir_cron_auto_tag_lost_customers" model="ir.cron">
            <field name="name">Customer: Auto-Tag Lost Customers (6+ Months Inactive)</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_lost_customers()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>

