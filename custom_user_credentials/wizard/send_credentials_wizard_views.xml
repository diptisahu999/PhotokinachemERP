<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_send_user_credentials_wizard_form" model="ir.ui.view">
        <field name="name">send.user.credentials.wizard.form</field>
        <field name="model">send.user.credentials.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Login Credentials via Email">
                <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                    <i class="fa fa-info-circle fa-2x me-3 text-primary"/>
                    <div>
                        <strong>Send Login Details</strong><br/>
                        This action will email the <strong>Project URL</strong>, <strong>Login/Email</strong>, and <strong>Password</strong> to the user. You can modify any details below before sending.
                    </div>
                </div>

                <group>
                    <group string="Recipient Information">
                        <field name="user_id" readonly="1" options="{'no_open': True}"/>
                        <field name="recipient_name" invisible="1"/>
                        <field name="email" placeholder="e.g. user@photokinachem.com" required="1"/>
                    </group>
                    <group string="System &amp; Access Details">
                        <field name="project_url" placeholder="e.g. http://localhost:9904 or https://erp.photokinachem.com" required="1"/>
                        <label for="password" string="Password"/>
                        <div class="d-flex align-items-center">
                            <field name="password" class="me-2" style="font-family: monospace; font-size: 14px; font-weight: bold;"/>
                            <button name="action_regenerate_password"
                                    type="object"
                                    class="btn btn-sm btn-outline-secondary text-nowrap"
                                    icon="fa-refresh"
                                    title="Generate another random secure password"/>
                        </div>
                    </group>
                </group>

                <group string="Options">
                    <field name="update_user_password"/>
                    <field name="send_copy_to_admin"/>
                </group>

                <footer>
                    <button name="action_send_mail"
                            string="Send Mail"
                            type="object"
                            class="btn-primary"
                            icon="fa-paper-plane"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_send_user_credentials_wizard" model="ir.actions.act_window">
        <field name="name">Send Login Credentials</field>
        <field name="res_model">send.user.credentials.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
