<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="stage_submitted" model="ticket.stage">
        <field name="name">New / Submitted</field>
        <field name="sequence">10</field>
        <field name="state">draft</field>
        <field name="fold" eval="False"/>
        <field name="is_closed" eval="False"/>
        <field name="description">Newly created ticket awaiting owner review.</field>
    </record>

    <record id="stage_assigned" model="ticket.stage">
        <field name="name">Assigned</field>
        <field name="sequence">20</field>
        <field name="state">assigned</field>
        <field name="fold" eval="False"/>
        <field name="is_closed" eval="False"/>
        <field name="description">Assigned to an accountable owner.</field>
    </record>

    <record id="stage_in_progress" model="ticket.stage">
        <field name="name">In Progress</field>
        <field name="sequence">30</field>
        <field name="state">in_progress</field>
        <field name="fold" eval="False"/>
        <field name="is_closed" eval="False"/>
        <field name="description">Owner has acknowledged and is actively investigating/working on resolution.</field>
    </record>

    <record id="stage_on_hold" model="ticket.stage">
        <field name="name">Under Review / On Hold</field>
        <field name="sequence">40</field>
        <field name="state">on_hold</field>
        <field name="fold" eval="False"/>
        <field name="is_closed" eval="False"/>
        <field name="description">Ticket on hold pending external vendor, spares, or management approval.</field>
    </record>

    <record id="stage_resolved" model="ticket.stage">
        <field name="name">Resolved (Pending Verification)</field>
        <field name="sequence">50</field>
        <field name="state">resolved</field>
        <field name="fold" eval="False"/>
        <field name="is_closed" eval="False"/>
        <field name="description">Action taken and documented. Awaiting requester verification and satisfaction rating.</field>
    </record>

    <record id="stage_closed" model="ticket.stage">
        <field name="name">Closed</field>
        <field name="sequence">60</field>
        <field name="state">closed</field>
        <field name="fold" eval="False"/>
        <field name="is_closed" eval="True"/>
        <field name="description">Verified and formally closed with audit trail.</field>
    </record>

    <record id="stage_reopened" model="ticket.stage">
        <field name="name">Reopened</field>
        <field name="sequence">70</field>
        <field name="state">reopened</field>
        <field name="fold" eval="False"/>
        <field name="is_closed" eval="False"/>
        <field name="description">Ticket reopened by requester due to incomplete resolution.</field>
    </record>
</odoo>
