<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ticket_stage_list" model="ir.ui.view">
        <field name="name">ticket.stage.list</field>
        <field name="model">ticket.stage</field>
        <field name="arch" type="xml">
            <list string="Ticket Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state"/>
                <field name="fold"/>
                <field name="is_closed"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_ticket_stage" model="ir.actions.act_window">
        <field name="name">Ticket Stages</field>
        <field name="res_model">ticket.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure ticket lifecycle pipeline stages!</p>
        </field>
    </record>
</odoo>
