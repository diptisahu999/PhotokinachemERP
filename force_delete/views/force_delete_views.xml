<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Force Delete Button to MRP Production Form Header -->
    <record id="mrp_production_form_view_inherit_force_delete" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.force.delete</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_force_delete"
                        string="Force Delete"
                        type="object"
                        class="btn-outline-danger"
                        groups="force_delete.group_force_delete"
                        confirm="Are you sure you want to permanently delete this Manufacturing Order?"/>
            </xpath>
        </field>
    </record>

    <!-- Add Force Delete Button to Stock Picking Form Header -->
    <record id="view_picking_form_inherit_force_delete" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.force.delete</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_force_delete"
                        string="Force Delete"
                        type="object"
                        class="btn-outline-danger"
                        groups="force_delete.group_force_delete"
                        confirm="Are you sure you want to permanently delete this Transfer?"/>
            </xpath>
        </field>
    </record>
</odoo>
