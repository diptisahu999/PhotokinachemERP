<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action: Force Delete for Manufacturing Orders (mrp.production) -->
    <record id="action_mrp_production_force_delete" model="ir.actions.server">
        <field name="name">Force Delete</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('force_delete.group_force_delete'))]"/>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_force_delete()
        </field>
    </record>

