<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Privilege layer for Sales Zone in Odoo 19 -->
    <record id="res_groups_privilege_sale_zone" model="res.groups.privilege">
        <field name="name">Sales Zone Access</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">10</field>
    </record>

    <!-- Security Group: Own Zone / Team Documents Only -->
    <record id="group_sale_salesman_zone_leads" model="res.groups">
        <field name="name">User: Own Zone / Team Documents Only</field>
        <field name="privilege_id" ref="res_groups_privilege_sale_zone"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">The user will only have access to CRM Leads/Opportunities and Sales Orders belonging to their assigned Sales Teams / Zones.</field>
    </record>

    <!-- Adjust hierarchy so All Documents inherits Zone Documents -->
    <record id="sales_team.group_sale_salesman_all_leads" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('crm_sale_zone_segregation.group_sale_salesman_zone_leads'))]"/>
    </record>

    <!-- Adjust standard personal lead rule so unassigned leads belonging to other teams are not leaked -->
    <record id="crm.crm_rule_personal_lead" model="ir.rule">
        <field name="domain_force">['|', ('user_id', '=', user.id), '&amp;', ('user_id', '=', False), ('team_id', '=', False)]</field>
    </record>

    <!-- CRM Lead Rule for Zone Salesperson -->
    <record id="crm_lead_rule_zone_leads" model="ir.rule">
        <field name="name">Zone Salesperson: Leads &amp; Opportunities in assigned Zone</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">['|', '|', '|', ('team_id.member_ids', 'in', [user.id]), ('team_id.user_id', '=', user.id), ('user_id', '=', user.id), '&amp;', ('team_id', '=', False), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('crm_sale_zone_segregation.group_sale_salesman_zone_leads'))]"/>
    </record>

    <!-- Adjust standard personal sale order rule so orders with other teams are not leaked -->
    <record id="sale.sale_order_personal_rule" model="ir.rule">
        <field name="domain_force">['|', ('user_id', '=', user.id), '&amp;', ('user_id', '=', False), ('team_id', '=', False)]</field>
    </record>

    <!-- Sales Order Rule for Zone Salesperson -->
    <record id="sale_order_rule_zone_orders" model="ir.rule">
        <field name="name">Zone Salesperson: Quotations &amp; Orders in assigned Zone</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">['|', '|', '|', ('team_id.member_ids', 'in', [user.id]), ('team_id.user_id', '=', user.id), ('user_id', '=', user.id), '&amp;', ('team_id', '=', False), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('crm_sale_zone_segregation.group_sale_salesman_zone_leads'))]"/>
    </record>

</odoo>
