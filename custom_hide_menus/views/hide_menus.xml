<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide Project Menu from Sidebar/Navigation -->
    <record id="project.menu_main_pm" model="ir.ui.menu">
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('group_hidden_app_menus')])]"/>
    </record>

    <!-- Hide Link Tracker Menu from Sidebar/Navigation -->
    <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('group_hidden_app_menus')])]"/>
    </record>

    <!-- Hide Surveys Menu from Sidebar/Navigation -->
    <record id="survey.menu_surveys" model="ir.ui.menu">
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('group_hidden_app_menus')])]"/>
    </record>
</odoo>
